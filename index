<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday Nsywa! ✨</title>
    <!-- Tailwind CSS for modern styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Poppins & Great Vibes for luxury aesthetic -->
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Canvas Confetti library -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #fdf2f8 0%, #fce7f3 50%, #fbcfe8 100%);
            color: #831843;
            overflow-x: hidden;
        }
        .font-script {
            font-family: 'Great Vibes', cursive;
        }
        /* Custom animations */
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-15px) rotate(3deg); }
        }
        .animate-float {
            animation: float 4s ease-in-out infinite;
        }
        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 15px rgba(244, 114, 182, 0.6); }
            50% { box-shadow: 0 0 30px rgba(236, 72, 153, 0.9); }
        }
        .glow-box {
            animation: pulse-glow 3s infinite;
        }
        /* Glassmorphism card style */
        .glass-card {
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.9);
        }
        /* Flame flicker for candle */
        @keyframes flicker {
            0%, 100% { transform: scale(1) rotate(-2deg); opacity: 0.9; }
            50% { transform: scale(1.1) rotate(2deg); opacity: 1; filter: drop-shadow(0 0 8px #f43f5e); }
        }
        .flame {
            animation: flicker 0.6s infinite alternate;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-pink-300 selection:text-pink-900">

    <!-- Floating Hearts & Sparkles Background Decor -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0 opacity-40">
        <div class="absolute top-10 left-10 text-pink-400 text-2xl animate-float" style="animation-delay: 0s;">💖</div>
        <div class="absolute top-1/4 right-16 text-pink-300 text-3xl animate-float" style="animation-delay: 1.5s;">✨</div>
        <div class="absolute bottom-20 left-1/4 text-rose-300 text-4xl animate-float" style="animation-delay: 2.2s;">🌸</div>
        <div class="absolute bottom-10 right-1/3 text-pink-400 text-2xl animate-float" style="animation-delay: 0.8s;">✨</div>
        <div class="absolute top-1/2 left-5 text-rose-400 text-3xl animate-float" style="animation-delay: 3s;">💗</div>
    </div>

    <!-- Music Player Controls -->
    <div class="fixed top-4 right-4 z-50">
        <button id="musicToggle" onclick="toggleMusic()" class="glass-card px-4 py-2 rounded-full shadow-lg flex items-center space-x-2 text-pink-700 hover:bg-pink-100 transition duration-300 border border-pink-200">
            <i id="musicIcon" class="fa-solid fa-music animate-spin"></i>
            <span id="musicText" class="text-xs font-semibold">Putar Musik</span>
        </button>
        <!-- Embedded romantic music audio (Royalty-free upbeat acoustic/romantic tune) -->
        <audio id="bgMusic" loop>
            <source src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf756.mp3?filename=cute-bg-112173.mp3" type="audio/mpeg">
        </audio>
    </div>

    <!-- Main Content Wrapper -->
    <main class="relative z-10 max-w-4xl mx-auto px-4 py-8 flex flex-col items-center w-full">
        
        <!-- Welcome Badge -->
        <div class="glass-card px-6 py-2 rounded-full shadow-sm mb-6 text-center border border-pink-200 animate-bounce">
            <span class="text-xs uppercase tracking-widest font-bold text-pink-600">✨ Special Birthday Celebration ✨</span>
        </div>

        <!-- Hero Title Card -->
        <div class="glass-card w-full rounded-3xl p-8 sm:p-12 shadow-xl text-center mb-8 glow-box border border-white">
            <h1 class="font-script text-6xl sm:text-8xl text-pink-600 mb-2 drop-shadow-md">Happy Birthday</h1>
            <h2 class="text-3xl sm:text-5xl font-extrabold text-pink-900 tracking-wider mb-4 uppercase">Nsywa!</h2>
            
            <div class="inline-block bg-gradient-to-r from-pink-500 to-rose-500 text-white font-semibold px-6 py-2 rounded-full shadow-md text-sm sm:text-base mb-6">
                <i class="fa-solid fa-cake-candles mr-2"></i> 31 Mei 2007 • <span id="ageDisplay">19</span> Tahun 🎉
            </div>

            <p id="typingText" class="text-pink-800 text-base sm:text-lg max-w-xl mx-auto font-medium min-h-[4rem] leading-relaxed"></p>

            <!-- Action Trigger Buttons -->
            <div class="flex flex-wrap justify-center gap-4 mt-6">
                <button onclick="triggerParty()" class="bg-gradient-to-r from-pink-500 to-rose-500 hover:from-pink-600 hover:to-rose-600 text-white font-bold py-3 px-6 rounded-full shadow-lg transform hover:scale-105 transition duration-300 flex items-center space-x-2">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    <span>Letupkan Kembang Api!</span>
                </button>
                <button onclick="scrollToSection('giftSection')" class="bg-white hover:bg-pink-50 text-pink-700 border border-pink-300 font-bold py-3 px-6 rounded-full shadow-md transform hover:scale-105 transition duration-300 flex items-center space-x-2">
                    <i class="fa-solid fa-gift"></i>
                    <span>Buka Kado Spesial</span>
                </button>
            </div>
        </div>

        <!-- Virtual Birthday Cake Section -->
        <div class="glass-card w-full rounded-3xl p-8 shadow-xl mb-8 text-center">
            <h3 class="text-2xl font-bold text-pink-900 mb-2"><i class="fa-solid fa-fire text-amber-500 mr-2"></i>Kue Ulang Tahun Virtual</h3>
            <p class="text-pink-700 text-sm mb-6">Tiup lilinnya dan buat permohonan terbaikmu hari ini, Nsywa!</p>
            
            <div class="relative flex justify-center items-center my-8">
                <!-- Cake Illustration using HTML/CSS & SVG -->
                <div class="relative flex flex-col items-center">
                    <!-- Candles -->
                    <div class="flex space-x-4 mb-1">
                        <div class="flex flex-col items-center">
                            <div id="flame1" class="w-4 h-6 bg-gradient-to-t from-amber-500 to-yellow-300 rounded-full flame cursor-pointer" onclick="blowCandle(1)"></div>
                            <div class="w-1.5 h-8 bg-pink-400 rounded-t"></div>
                        </div>
                        <div class="flex flex-col items-center">
                            <div id="flame2" class="w-4 h-6 bg-gradient-to-t from-amber-500 to-yellow-300 rounded-full flame cursor-pointer" onclick="blowCandle(2)"></div>
                            <div class="w-1.5 h-8 bg-pink-400 rounded-t"></div>
                        </div>
                        <div class="flex flex-col items-center">
                            <div id="flame3" class="w-4 h-6 bg-gradient-to-t from-amber-500 to-yellow-300 rounded-full flame cursor-pointer" onclick="blowCandle(3)"></div>
                            <div class="w-1.5 h-8 bg-pink-400 rounded-t"></div>
                        </div>
                    </div>
                    <!-- Cake Top Tier -->
                    <div class="w-32 h-16 bg-gradient-to-r from-pink-300 via-pink-400 to-pink-300 rounded-t-2xl shadow-inner border-b-2 border-pink-500 flex justify-center items-center">
                        <span class="text-white font-bold text-xs tracking-widest">NSYWA</span>
                    </div>
                    <!-- Cake Bottom Tier -->
                    <div class="w-48 h-20 bg-gradient-to-r from-rose-300 via-pink-400 to-rose-300 rounded-lg shadow-lg border-t-2 border-white flex justify-around items-end pb-2">
                        <div class="w-3 h-3 bg-white rounded-full"></div>
                        <div class="w-3 h-3 bg-white rounded-full"></div>
                        <div class="w-3 h-3 bg-white rounded-full"></div>
                        <div class="w-3 h-3 bg-white rounded-full"></div>
                        <div class="w-3 h-3 bg-white rounded-full"></div>
                    </div>
                    <!-- Cake Plate -->
                    <div class="w-56 h-4 bg-gray-200 rounded-full shadow-md mt-1"></div>
                </div>
            </div>

            <button onclick="blowAllCandles()" class="bg-pink-600 hover:bg-pink-700 text-white text-sm font-semibold py-2 px-6 rounded-full shadow transition duration-300">
                <i class="fa-solid fa-wind mr-1"></i> Tiup Semua Lilin
            </button>
            <p id="candleStatus" class="text-xs text-pink-600 font-medium mt-3">Klik lilin atau tombol untuk meniupnya!</p>
        </div>

        <!-- Gift Boxes Section -->
        <div id="giftSection" class="glass-card w-full rounded-3xl p-8 shadow-xl mb-8 text-center">
            <h3 class="text-2xl font-bold text-pink-900 mb-2"><i class="fa-solid fa-gift text-pink-600 mr-2"></i>Kotak Kado Misteri</h3>
            <p class="text-pink-700 text-sm mb-6">Pilih dan klik salah satu kado di bawah ini untuk melihat pesan spesial untuk Nsywa!</p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                <!-- Gift 1 -->
                <div onclick="openGift(1)" class="glass-card bg-white/60 p-6 rounded-2xl shadow-md cursor-pointer hover:bg-pink-50 hover:scale-105 transition duration-300 border border-pink-200 flex flex-col items-center">
                    <div id="giftIcon1" class="text-5xl text-pink-500 mb-3 animate-bounce">🎁</div>
                    <h4 class="font-bold text-pink-900">Kado Pertama</h4>
                    <p id="giftMsg1" class="text-xs text-pink-600 mt-2">Klik untuk membuka!</p>
                </div>
                <!-- Gift 2 -->
                <div onclick="openGift(2)" class="glass-card bg-white/60 p-6 rounded-2xl shadow-md cursor-pointer hover:bg-pink-50 hover:scale-105 transition duration-300 border border-pink-200 flex flex-col items-center">
                    <div id="giftIcon2" class="text-5xl text-rose-500 mb-3 animate-bounce" style="animation-delay: 0.3s;">🎁</div>
                    <h4 class="font-bold text-pink-900">Kado Kedua</h4>
                    <p id="giftMsg2" class="text-xs text-pink-600 mt-2">Klik untuk membuka!</p>
                </div>
                <!-- Gift 3 -->
                <div onclick="openGift(3)" class="glass-card bg-white/60 p-6 rounded-2xl shadow-md cursor-pointer hover:bg-pink-50 hover:scale-105 transition duration-300 border border-pink-200 flex flex-col items-center">
                    <div id="giftIcon3" class="text-5xl text-pink-600 mb-3 animate-bounce" style="animation-delay: 0.6s;">🎁</div>
                    <h4 class="font-bold text-pink-900">Kado Ketiga</h4>
                    <p id="giftMsg3" class="text-xs text-pink-600 mt-2">Klik untuk membuka!</p>
                </div>
            </div>
        </div>

        <!-- Countdown to Next Birthday & Wishes -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full mb-8">
            <!-- Countdown Timer -->
            <div class="glass-card rounded-3xl p-6 shadow-xl flex flex-col justify-between text-center">
                <h3 class="text-xl font-bold text-pink-900 mb-3"><i class="fa-solid fa-hourglass-half mr-2"></i>Menuju Ulang Tahun Berikutnya</h3>
                <div class="grid grid-cols-4 gap-2 my-4">
                    <div class="bg-white/80 p-3 rounded-xl shadow-sm">
                        <span id="days" class="text-2xl font-bold text-pink-600">00</span>
                        <p class="text-[10px] uppercase font-semibold text-pink-800">Hari</p>
                    </div>
                    <div class="bg-white/80 p-3 rounded-xl shadow-sm">
                        <span id="hours" class="text-2xl font-bold text-pink-600">00</span>
                        <p class="text-[10px] uppercase font-semibold text-pink-800">Jam</p>
                    </div>
                    <div class="bg-white/80 p-3 rounded-xl shadow-sm">
                        <span id="minutes" class="text-2xl font-bold text-pink-600">00</span>
                        <p class="text-[10px] uppercase font-semibold text-pink-800">Menit</p>
                    </div>
                    <div class="bg-white/80 p-3 rounded-xl shadow-sm">
                        <span id="seconds" class="text-2xl font-bold text-pink-600">00</span>
                        <p class="text-[10px] uppercase font-semibold text-pink-800">Detik</p>
                    </div>
                </div>
                <p class="text-xs text-pink-600">Setiap detik adalah berkah baru untuk Nsywa! 💖</p>
            </div>

            <!-- Sweet Wishes Wall / Note Generator -->
            <div class="glass-card rounded-3xl p-6 shadow-xl flex flex-col justify-between text-center">
                <h3 class="text-xl font-bold text-pink-900 mb-3"><i class="fa-solid fa-envelope-open-text mr-2"></i>Kartu Ucapan Manis</h3>
                <div id="wishBox" class="bg-white/70 p-4 rounded-2xl shadow-inner min-h-[5rem] flex items-center justify-center text-pink-800 font-medium text-sm my-2">
                    "Semoga di usia yang baru ini, Nsywa semakin bahagia, sukses dalam segala hal, dan impian-impiannya tercapai satu per satu. Happy Birthday pokoknya! ✨"
                </div>
                <button onclick="generateNewWish()" class="bg-pink-500 hover:bg-pink-600 text-white text-xs font-bold py-2 px-4 rounded-full shadow transition duration-300 mt-2">
                    <i class="fa-solid fa-rotate-right mr-1"></i> Acak Ucapan Lainnya
                </button>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="relative z-10 text-center py-6 text-pink-700 text-xs font-medium">
        <p>Made with 💖 specially for <span class="font-bold">Nsywa</span> • Happy Birthday Pokoknya!</p>
    </footer>

    <!-- JavaScript Code -->
    <script>
        // 1. Calculate Age Automatically based on birth date (31 May 2007)
        function calculateAge() {
            const birthDate = new Date(2007, 4, 31); // May is month 4 (0-indexed)
            const today = new Date();
            let age = today.getFullYear() - birthDate.getFullYear();
            const m = today.getMonth() - birthDate.getMonth();
            if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
                age--;
            }
            document.getElementById('ageDisplay').innerText = age;
        }
        calculateAge();

        // 2. Typing Effect for Hero Description
        const messages = [
            "Hai Nsywa! Selamat ulang tahun ya! Semoga hari-harimu selalu dipenuhi senyuman, kebahagiaan, dan hal-hal baik di sekitar kamu. Happy Birthday pokoknya! 🎉💖",
            "Teruntuk Nsywa tercinta, selamat bertambah usia! Semoga panjang umur, sehat selalu, makin keren, dan semua cita-citanya dimudahkan Tuhan. Aamiin! ✨🎂"
        ];
        let msgIndex = 0;
        let charIndex = 0;
        let currentMessage = messages[0];
        const typingElement = document.getElementById('typingText');

        function typeWriter() {
            if (charIndex < currentMessage.length) {
                typingElement.innerHTML += currentMessage.charAt(charIndex);
                charIndex++;
                setTimeout(typeWriter, 40);
            } else {
                setTimeout(eraseWriter, 4000);
            }
        }

        function eraseWriter() {
            if (charIndex > 0) {
                typingElement.innerHTML = currentMessage.substring(0, charIndex - 1);
                charIndex--;
                setTimeout(eraseWriter, 20);
            } else {
                msgIndex = (msgIndex + 1) % messages.length;
                currentMessage = messages[msgIndex];
                setTimeout(typeWriter, 500);
            }
        }
        setTimeout(typeWriter, 500);

        // 3. Music Player Toggle
        let isPlaying = false;
        const bgMusic = document.getElementById('bgMusic');
        const musicIcon = document.getElementById('musicIcon');
        const musicText = document.getElementById('musicText');

        function toggleMusic() {
            if (!isPlaying) {
                bgMusic.play().then(() => {
                    isPlaying = true;
                    musicIcon.className = "fa-solid fa-music fa-spin";
                    musicText.innerText = "Matikan Musik";
                }).catch(e => {
                    console.log("Audio play blocked", e);
                });
            } else {
                bgMusic.pause();
                isPlaying = false;
                musicIcon.className = "fa-solid fa-volume-xmark";
                musicText.innerText = "Putar Musik";
            }
        }

        // 4. Confetti & Fireworks Trigger
        function triggerParty() {
            confetti({
                particleCount: 120,
                spread: 80,
                origin: { y: 0.6 },
                colors: ['#f472b6', '#ec4899', '#fb7185', '#ffffff', '#f43f5e']
            });
        }
        // Auto trigger confetti on load after 1 second
        setTimeout(triggerParty, 1000);

        // 5. Virtual Cake Candle Blowing
        let candlesBlown = 0;
        function blowCandle(candleNum) {
            const flame = document.getElementById(`flame${candleNum}`);
            if (flame.style.display !== 'none') {
                flame.style.display = 'none';
                candlesBlown++;
                checkAllCandles();
            }
        }

        function blowAllCandles() {
            for (let i = 1; i <= 3; i++) {
                document.getElementById(`flame${i}`).style.display = 'none';
            }
            candlesBlown = 3;
            checkAllCandles();
        }

        function checkAllCandles() {
            const status = document.getElementById('candleStatus');
            if (candlesBlown >= 3) {
                status.innerHTML = "🎉 Hore! Semua lilin berhasil ditiup! Doa-doanya semoga terkabul ya, Nsywa! ✨";
                triggerParty();
            } else {
                status.innerHTML = `Lilin tertiup: ${candlesBlown}/3. Tiup sisanya ya!`;
            }
        }

        // 6. Mystery Gift Boxes Handler
        const giftMessages = [
            "🎁 Kado 1: 'Semoga tahun ini membawa banyak kejutan manis, petualangan seru, dan pencapaian hebat untuk Nsywa!'",
            "💖 Kado 2: 'Tetap jadi pribadi yang ceria, baik hati, dan inspiratif buat orang-orang di sekitarmu ya!'",
            "✨ Kado 3: 'Happy Birthday pokoknya buat Nsywa! Jangan lupa tersenyum hari ini karena kamu sangat berharga!'"
        ];

        function openGift(boxNum) {
            const icon = document.getElementById(`giftIcon${boxNum}`);
            const msg = document.getElementById(`giftMsg${boxNum}`);
            
            icon.innerText = "🎉";
            msg.innerText = giftMessages[boxNum - 1];
            msg.className = "text-xs font-semibold text-pink-800 mt-2 bg-pink-100 p-2 rounded-lg";
            
            triggerParty();
        }

        // 7. Countdown Timer to Next Birthday (May 31)
        function updateCountdown() {
            const now = new Date();
            let currentYear = now.getFullYear();
            let nextBirthday = new Date(currentYear, 4, 31); // May 31
            
            if (now > nextBirthday) {
                nextBirthday = new Date(currentYear + 1, 4, 31);
            }

            const diff = nextBirthday - now;
            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
            const minutes = Math.floor((diff / 1000 / 60) % 60);
            const seconds = Math.floor((diff / 1000) % 60);

            document.getElementById('days').innerText = String(days).padStart(2, '0');
            document.getElementById('hours').innerText = String(hours).padStart(2, '0');
            document.getElementById('minutes').innerText = String(minutes).padStart(2, '0');
            document.getElementById('seconds').innerText = String(seconds).padStart(2, '0');
        }
        setInterval(updateCountdown, 1000);
        updateCountdown();

        // 8. Random Wishes Generator
        const randomWishes = [
            "\"Semoga di usia yang baru ini, Nsywa semakin bahagia, sukses dalam segala hal, dan impian-impiannya tercapai satu per satu. Happy Birthday pokoknya! ✨\"",
            "\"Selamat ulang tahun untuk Nsywa! Semoga hari-harimu selalu dikelilingi orang-orang yang tulus dan penuh cinta. Keep shining! 💖\"",
            "\"Semoga bertambahnya usia ini membawamu pada kedewasaan, kebahagiaan yang melimpah, serta rezeki yang berkah. Happy Birthday Nsywa! 🎂\"",
            "\"Wishing you a day as gorgeous and wonderful as you are! Happy Birthday Nsywa, stay awesome pokoknya! 🌸\""
        ];

        function generateNewWish() {
            const randomIndex = Math.floor(Math.random() * randomWishes.length);
            document.getElementById('wishBox').innerText = randomWishes[randomIndex];
        }

        // Scroll helper
        function scrollToSection(id) {
            document.getElementById(id).scrollIntoView({ behavior: 'smooth' });
        }
    </script>
</body>
</html>
